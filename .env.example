# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# URL pública usada na documentação (opcional)
# PUBLIC_URL=https://scheduler.exemplo.com

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
WHATSAPP_LOG_LEVEL=warn

# Timezone IANA usada pelos agendamentos
TIMEZONE=America/Bahia

# Autenticação (obrigatória; senha com pelo menos 8 caracteres)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=troque-esta-senha
RATE_LIMIT_MAX=300

# Persistência
DATABASE_PATH=./storage/db/database.sqlite
MEDIA_PATH=./storage/media
AUTH_PATH=./storage/auth
MAX_UPLOAD_MB=16

# Scheduler
SCHEDULER_TICK_SECONDS=30
SCHEDULER_CATCHUP_MINUTES=60
SCHEDULER_MAX_ATTEMPTS=3

# Build do frontend (servido pelo Fastify)
WEB_DIST_PATH=./web/dist
